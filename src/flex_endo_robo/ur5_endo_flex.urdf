    <inertial>
      <mass value="0.1879"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159"/>
      <inertia ixx="8.062475833333332e-05" ixy="0" ixz="0" iyy="8.062475833333332e-05" iyz="0" izz="0.0001321171875"/>
    </inertial>
  </link>
  <!-- base_joint fixes base_link to the environment -->
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.8"/>
    <parent link="supporter_link"/>
    <child link="base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.089159"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.39225 0 0.10915"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.09465 -1.941303950897609e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0823 -1.688001216681175e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <!-- kg     -->
  <link name="endoscope_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur5_endoscope/meshes/endoscope_mid.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <!-- cylinder centred on its origin, aligned along +Z -->
      <origin rpy="0 0 0" xyz="-0.0193 -0.01615 -0.12955"/>
      <geometry>
        <cylinder length="0.663" radius="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="-0.0193 -0.01615 -0.12955"/>
      <inertia ixx="0.0185685" ixy="0" ixz="0" iyy="0.0185685" iyz="0" izz="0.00050625"/>
    </inertial>
  </link>
  <!-- <joint name="tool0_to_endoscope_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="endoscope_link"/>
    <origin xyz="0.09545 0 0.058" rpy="1.5708 -0.9547 -1.5708"/>
  </joint> -->
  <!--
    The 45 deg yaw correction is applied about the UR5 tool0 origin
    (the circle-flange centre, 0,0,0 in the tool0 frame) rather than
    about the endoscope_link origin.

        T_new = R_z(-45 deg) * T_old
              = Translate(0.06749, -0.06749, 0.058) * R_rpy(1.5708, -0.9547, -2.3562)

    The endoscope final orientation in the tool0 frame is identical to
    before; only the translation of the endoscope_link origin changes.
    NOTE this comment uses no colons on purpose.  In ROS 2 Jazzy the
    xacro output is passed as a parameter and gets parsed as YAML,
    and any bare colon (e.g. "Mathematically") in the URDF text would
    break the launch.  Double hyphens are also avoided because XML
    forbids them inside an XML comment.
  -->
  <joint name="tool0_to_endoscope_joint" type="fixed">
    <parent link="tool0"/>
    <child link="endoscope_link"/>
    <origin rpy="1.5708 -0.9547 -2.3562" xyz="0.06749 -0.06749 0.058"/>
  </joint>
  <!-- ============================================================= -->
  <!-- Make the supporter static in Gazebo (prevents any drift)      -->
  <!-- ============================================================= -->
  <gazebo reference="supporter_link">
    <static>true</static>
  </gazebo>
  <!-- ============================================================= -->
  <!-- ros2_control hardware interface for Gazebo                    -->
  <!-- (UR joints only - the endo-flex continuum joints are NOT      -->
  <!--  actuated through this interface.)                            -->
  <!-- ============================================================= -->
  <ros2_control name="ur5_with_endoscope" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- ============================================================= -->
  <!-- Gazebo Sim plugin that loads gz_ros2_control + controllers    -->
  <!-- position_proportional_gain default 0.1 is too low for a UR5;  -->
  <!-- 1.0 is a typical, stable value.                               -->
  <!-- ============================================================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/media/yuxuanzhang/yuxuazha/Projects/ur5_sim_ws/install/ur_simulation_gz/share/ur_simulation_gz/config/ur_controllers.yaml</parameters>
      <position_proportional_gain>1.0</position_proportional_gain>
    </plugin>
  </gazebo>
  <!-- ============ Materials (global) ============ -->
  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="camera_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="tendon_red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="tendon_green">
    <color rgba="0.0 1.0 0.0 1.0"/>
  </material>
  <material name="tendon_blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="tendon_yellow">
    <color rgba="1.0 1.0 0.0 1.0"/>
  </material>
  <!-- ============ Root ============ -->
  <link name="flex_base_link"/>
  <joint name="base_fixed" type="fixed">
    <parent link="flex_base_link"/>
    <child link="start_cylinder"/>
  </joint>
  <link name="start_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.005" radius="0.005"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="start_cylinder"/>
    <child link="yaw_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.0025"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14159" upper="3.14159" velocity="10"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_yaw</joint_name>
      <topic>/flex/base_yaw</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>20.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>
  </gazebo>
  <link name="yaw_base">
    <inertial>
      <mass value="1e-3"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="seg1_fixed" type="fixed">
    <parent link="yaw_base"/>
    <child link="segment_1"/>
  </joint>
  <!-- Segment 1 -->
  <link name="segment_1">
    <inertial>
      <origin xyz="0 0 0.004"/>
      <mass value="1e-3"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <link name="tendon_0_s1">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_red"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_0_s1_joint" type="fixed">
    <parent link="segment_1"/>
    <child link="tendon_0_s1"/>
    <origin rpy="0 0 0" xyz="0.004 0 0.004"/>
  </joint>
  <link name="tendon_90_s1">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_green"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_90_s1_joint" type="fixed">
    <parent link="segment_1"/>
    <child link="tendon_90_s1"/>
    <origin rpy="0 0 0" xyz="0 0.004 0.004"/>
  </joint>
  <link name="tendon_180_s1">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_blue"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_180_s1_joint" type="fixed">
    <parent link="segment_1"/>
    <child link="tendon_180_s1"/>
    <origin rpy="0 0 0" xyz="-0.004 0 0.004"/>
  </joint>
  <link name="tendon_270_s1">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_yellow"/>
