  <link name="tendon_0_s8">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_red"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_0_s8_joint" type="fixed">
    <parent link="segment_8"/>
    <child link="tendon_0_s8"/>
    <origin rpy="0 0 0" xyz="0.004 0 0.004"/>
  </joint>
  <link name="tendon_90_s8">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_green"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_90_s8_joint" type="fixed">
    <parent link="segment_8"/>
    <child link="tendon_90_s8"/>
    <origin rpy="0 0 0" xyz="0 0.004 0.004"/>
  </joint>
  <link name="tendon_180_s8">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_blue"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_180_s8_joint" type="fixed">
    <parent link="segment_8"/>
    <child link="tendon_180_s8"/>
    <origin rpy="0 0 0" xyz="-0.004 0 0.004"/>
  </joint>
  <link name="tendon_270_s8">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_yellow"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_270_s8_joint" type="fixed">
    <parent link="segment_8"/>
    <child link="tendon_270_s8"/>
    <origin rpy="0 0 0" xyz="0 -0.004 0.004"/>
  </joint>
  <joint name="end_fixed" type="fixed">
    <parent link="segment_8"/>
    <child link="end_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="end_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.005" radius="0.005"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <link name="tendon_0_end">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_red"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_0_end_joint" type="fixed">
    <parent link="end_cylinder"/>
    <child link="tendon_0_end"/>
    <origin rpy="0 0 0" xyz="0.004 0 0"/>
  </joint>
  <link name="tendon_90_end">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_green"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_90_end_joint" type="fixed">
    <parent link="end_cylinder"/>
    <child link="tendon_90_end"/>
    <origin rpy="0 0 0" xyz="0 0.004 0"/>
  </joint>
  <link name="tendon_180_end">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_blue"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_180_end_joint" type="fixed">
    <parent link="end_cylinder"/>
    <child link="tendon_180_end"/>
    <origin rpy="0 0 0" xyz="-0.004 0 0"/>
  </joint>
  <link name="tendon_270_end">
    <visual>
      <geometry>
        <sphere radius="0.0008"/>
      </geometry>
      <material name="tendon_yellow"/>
    </visual>
    <inertial>
      <mass value="1e-9"/>
      <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
    </inertial>
  </link>
  <joint name="tendon_270_end_joint" type="fixed">
    <parent link="end_cylinder"/>
    <child link="tendon_270_end"/>
    <origin rpy="0 0 0" xyz="0 -0.004 0"/>
  </joint>
  <!-- ================================================================
       Distal Endoscope Camera at the Tip of end_cylinder
       ================================================================
       end_cylinder's distal tip face is at z = +CYL_LEN/2 (+0.0025 m)
       and looks along +Z of end_cylinder.
       Gazebo camera sensors look along +X of their link frame, so
       camera_link is pitched by -90 deg (-pi/2) about Y so that
       camera_link +X aligns with end_cylinder +Z.
       ================================================================ -->
  <joint name="end_cylinder_to_camera_joint" type="fixed">
    <parent link="end_cylinder"/>
    <child link="camera_link"/>
    <origin rpy="0 -1.57079632679 0" xyz="0 0 0.003"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.0015"/>
      </geometry>
      <material name="camera_black"/>
    </visual>
    <inertial>
      <mass value="1e-6"/>
      <inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12"/>
    </inertial>
  </link>
  <!-- Standard ROS camera optical frame (+Z forward, +X right, +Y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <!-- Gazebo Harmonic sensor plugin (loads ogre2 rendering for camera) -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="endoscope_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>60.0</update_rate>
      <topic>/endoscope_camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="endoscope_cam">
        <camera_info_topic>/endoscope_camera/camera_info</camera_info_topic>
        <horizontal_fov>2.2689</horizontal_fov>
        <image>
          <width>1500</width>
          <height>1500</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.008</near>
          <far>0.5</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <!-- Mount joint endoscope_link to flex_base_link
       origin xyz 0 0 -0.398 m  rpy 3.141593 0 0.616096 rad
       computed so flex z is minus endoscope z, flex x is tool0 z -->
  <joint name="endoscope_to_flex_joint" type="fixed">
    <parent link="endoscope_link"/>
    <child link="flex_base_link"/>
    <origin rpy="3.141593 0 0.616096" xyz="0 0 -0.398"/>
  </joint>
</robot>
